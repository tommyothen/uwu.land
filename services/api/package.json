{
  "name": "uwu-land-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/worker.ts"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --port 8787 --inspector-port 9230",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.node-tests.mjs",
    "ban": "node scripts/banned.mjs ban",
    "unban": "node scripts/banned.mjs unban",
    "banned": "node scripts/banned.mjs list",
    "ban:seed-urlhaus": "node scripts/seed-feed.mjs urlhaus",
    "abuse:top": "node scripts/abuse-top.mjs",
    "dsar": "node scripts/dsar.mjs",
    "purge:domain": "node scripts/purge-domain.mjs",
    "purge:owner": "node scripts/purge-owner.mjs",
    "suspend": "node scripts/suspend.mjs suspend",
    "unsuspend": "node scripts/suspend.mjs unsuspend"
  },
  "dependencies": {
    "@clerk/backend": "^3.11.2",
    "@uwu/db": "workspace:*",
    "@uwu/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.22",
    "nanoid": "^5.1.16",
    "tldts": "^7.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^5.20260710.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
